# Generated by scripts/build-detections.js -- do not edit by hand.
# Splunk SPL -- Steam credential phishing domain
# ATT&CK T1566.002, T1656
#
# Prerequisite: publish detections/lookups/steam-lookalike-domains.csv as the
# lookup definition `steam_lookalike_domains` (fields: host, signal). The list
# is data and the rule is logic; do not paste 2101 domains into the search.

index=proxy
| eval host=lower(cs_host), uri=lower(cs_uri)
``` official Steam domains short-circuit, exactly as the scorer allowlists them ```
| search NOT (host="steamcommunity.com" OR host="*.steamcommunity.com" OR host="steamgames.com" OR host="*.steamgames.com" OR host="steampowered.com" OR host="*.steampowered.com" OR host="steamstatic.com" OR host="*.steamstatic.com" OR host="valvesoftware.com" OR host="*.valvesoftware.com")
| lookup steam_lookalike_domains host OUTPUT signal AS lookalike_signal
| eval signal=case(
    isnotnull(lookalike_signal), "lookalike_domain",
    match(host, "(steamcommunity\.com|steamgames\.com|steampowered\.com|steamstatic\.com|valvesoftware\.com)\."), "embedded_official_host",
    match(host, "(steamcommunity|steamgames|steampowered|steamstatic|valvesoftware)"), "embedded_official_label",
    1=1, null())
| where isnotnull(signal)
| stats count AS hits, min(_time) AS first_seen, max(_time) AS last_seen, values(uri) AS uris
        BY host, src_ip, signal
| eval technique="T1566.002"
| sort - hits
