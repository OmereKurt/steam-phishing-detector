    "sync": "node scripts/sync-extension.js",
    "sync:check": "node scripts/sync-extension.js --check",
    "demo": "node scripts/demo.js",
    "discover": "node scripts/discover.js",
    "benchmark": "node scripts/benchmark.js"
  }
}
