{
  "name": "steam-phishing-detector",
  "version": "2.1.0",
  "description": "Chrome extension that scores Steam credential-phishing pages, with a labelled corpus and a measured detection rate.",
  "license": "MIT",
  "author": "Omer Kurt",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
